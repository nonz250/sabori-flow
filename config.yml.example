# schema_version: 1  # Config schema version. Written by `migrate`; do not edit manually

# Target repositories
repositories:
  - owner: your-org
    repo: example-app
    local_path: /Users/you/projects/example-app
    # default_branch: main  # Default branch used as the worktree starting point (default: main)
    priority_labels:
      - priority:high
      - priority:low

# Execution settings
execution:
  max_parallel: 1
  # max_issues_per_repo: 1  # Max issues per repository (default: 1)
  # agent: claude           # claude / codex (default: claude)
  # agent: [claude, codex]  # priority list; falls back to the next agent when one hits its usage limit
  # autonomy: interactive    # interactive / auto / full (default: interactive)
  #                          # auto: Claude Code --permission-mode auto (v2.1.83+, Max/Team/Enterprise)
  #                          #       Codex --approve-for-me (0.147.0+)
  #                          # full: Claude Code --dangerously-skip-permissions / Codex --yolo
  # interval_minutes: 10  # Scheduled execution interval in minutes (10-1440, default: 10)
  # timeout_minutes: 60   # Agent CLI execution timeout in minutes (1-240, default: 60)

# Display language
# language: ja  # ja / en (default: ja)

# Labels default to ai/* when omitted. Override per phase if needed:
# repositories:
#   - owner: ...
#     labels:
#       plan:
#         trigger: ai/plan
#         in_progress: ai/plan/in-progress
#         done: ai/plan/done
#         failed: ai/plan/failed
#       impl:
#         trigger: ai/impl
#         in_progress: ai/impl/in-progress
#         done: ai/impl/done
#         failed: ai/impl/failed
#       review:   # pull request review
#         trigger: ai/review
#         in_progress: ai/review/in-progress
#         done: ai/review/done
#         failed: ai/review/failed

# The Claude auth token is NOT stored here. Set it via `sabori-flow set-token` (saved to ~/.sabori-flow/auth-token) to avoid 401s during unattended runs.
